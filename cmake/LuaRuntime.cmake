# 使用官方 Lua 源码构建匹配 ABI 的运行时；不将第二份 Lua 嵌入 Unix 模块。
file(GLOB lua_sources CONFIGURE_DEPENDS "${LUASPDLOG_LUA_SOURCE_DIR}/src/*.c")
list(FILTER lua_sources EXCLUDE REGEX "/(lua|luac|print|onelua)\\.c$")
if(WIN32)
  add_library(lua_runtime SHARED ${lua_sources})
  target_compile_definitions(lua_runtime PUBLIC LUA_BUILD_AS_DLL)
  set_target_properties(lua_runtime PROPERTIES OUTPUT_NAME "lua${LUASPDLOG_LUA_ABI}")
else()
  add_library(lua_runtime STATIC ${lua_sources})
  target_compile_definitions(lua_runtime PRIVATE LUA_USE_POSIX LUA_USE_DLOPEN)
  target_link_libraries(lua_runtime PUBLIC ${CMAKE_DL_LIBS} m)
  set_target_properties(lua_runtime PROPERTIES OUTPUT_NAME lua POSITION_INDEPENDENT_CODE ON)
endif()
target_include_directories(lua_runtime PUBLIC "${LUASPDLOG_LUA_SOURCE_DIR}/src")
if(ANDROID AND CMAKE_SIZEOF_VOID_P EQUAL 4 AND CMAKE_SYSTEM_VERSION VERSION_LESS 24)
  # Android 32 位 API 21–23 尚无 64 位 stdio 定位符号，禁止 Lua 自动启用该重定向。
  target_compile_definitions(lua_runtime PRIVATE _FILE_OFFSET_BITS=32)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  target_compile_definitions(lua_runtime PRIVATE LUA_USE_IOS)
  target_compile_options(lua_runtime PRIVATE "-include" "${CMAKE_CURRENT_LIST_DIR}/ios_compat.h")
endif()
set(LUA_INCLUDE_DIR "${LUASPDLOG_LUA_SOURCE_DIR}/src")
set(LUA_LIBRARIES lua_runtime)
if(NOT CMAKE_CROSSCOMPILING)
  add_executable(lua_test_runtime "${LUASPDLOG_LUA_SOURCE_DIR}/src/lua.c")
  target_link_libraries(lua_test_runtime PRIVATE lua_runtime)
  set_target_properties(lua_test_runtime PROPERTIES OUTPUT_NAME lua ENABLE_EXPORTS ON)
  set(LUASPDLOG_LUA_EXECUTABLE "$<TARGET_FILE:lua_test_runtime>")
  install(TARGETS lua_test_runtime RUNTIME DESTINATION bin)
endif()
install(TARGETS lua_runtime RUNTIME DESTINATION bin LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
install(FILES "${LUA_INCLUDE_DIR}/lua.h" "${LUA_INCLUDE_DIR}/luaconf.h"
  "${LUA_INCLUDE_DIR}/lauxlib.h" "${LUA_INCLUDE_DIR}/lualib.h" DESTINATION include/lua)
